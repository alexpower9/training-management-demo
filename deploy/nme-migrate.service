[Unit]
Description=Apply NME compliance database migrations and runtime grants
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nme-migration
Group=nme-migration
SupplementaryGroups=nme-training
WorkingDirectory=/opt/nme-training
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin
Environment=NPM_CONFIG_CACHE=/tmp/npm-cache
EnvironmentFile=/etc/nme-training/migration.env
ExecStart=/usr/bin/env npm run migrate:production
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
