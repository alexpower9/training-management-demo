[Unit]
Description=Apply NME Training production database migrations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nme-training
Group=nme-training
WorkingDirectory=/opt/nme-training
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin
Environment=NPM_CONFIG_CACHE=/tmp/npm-cache
EnvironmentFile=/etc/nme-training/api.env
ExecStart=/usr/bin/env npm run migrate:production
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
