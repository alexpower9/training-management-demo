NODE_ENV=development
HOST=127.0.0.1
PORT=3000
AUTH_MODE=development
# Development requests may use x-demo-user-role: employee, admin, or owner.
# Local development only. Do not set a direct DATABASE_URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nme_training?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nme_training_test?schema=public

# Required when AUTH_MODE=cognito
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
COGNITO_CLIENT_ID=replace-me

# Required in production. The API uses this least-privilege runtime secret.
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:nme-training-runtime-db
# Used only by the production migration service. Do not put this in the API's
# production environment. This must name a different secret and database role
# from DATABASE_SECRET_ARN.
MIGRATION_DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:nme-training-migration-db
# Required by production API and migration environments when the managed
# secrets contain only username and password.
DATABASE_HOST=database.example.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=nme_training
RDS_CA_CERT_PATH=/etc/pki/rds/rds-ca-rsa2048-g1.pem
AWS_REGION=us-east-1
