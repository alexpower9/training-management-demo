NODE_ENV=development
HOST=127.0.0.1
PORT=3000
AUTH_MODE=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nme_training?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nme_training_test?schema=public

# Required when AUTH_MODE=cognito
COGNITO_USER_POOL_ID=ca-central-1_EXAMPLE
COGNITO_CLIENT_ID=replace-me

# Production alternative to DATABASE_URL. The EC2 role must be able to read this secret.
DATABASE_SECRET_ARN=arn:aws:secretsmanager:ca-central-1:123456789012:secret:nme-training-db
AWS_REGION=ca-central-1
